# Graft — configuration
#
# Graft calls an LLM for concept nodes + per-symbol summaries, so an API key is
# required for the deep pass (`build --deep`). The structural build (`build`,
# `check`, `ask`, `grep`, `map`, traversal) is deterministic tree-sitter and
# needs no key.
#
# Graft is vendor-neutral: GRAFT_PROVIDER picks the WIRE FORMAT, not a company.
# Bring your own key from whichever provider you use.
#
# Copy this file to .env and uncomment what you need; .env is git-ignored.

# --- Provider (required for `build --deep`) -----------------------------------
# Wire format / SDK: "openai" (any OpenAI-compatible endpoint), "anthropic",
# "litellm" (a LiteLLM proxy), or "orcarouter" (the OrcaRouter AI gateway).
# GRAFT_PROVIDER=openai
# Your provider API key.
# GRAFT_API_KEY=
# Model id, as your provider names it.
# GRAFT_MODEL=openai/gpt-4o-mini
# Base URL for the "openai" wire format: this is how you pick a provider.
# Leave unset to hit api.openai.com. Examples:
#   OpenRouter:  https://openrouter.ai/api/v1
#   Fireworks:   https://api.fireworks.ai/inference/v1
#   Groq:        https://api.groq.com/openai/v1
#   DeepSeek:    https://api.deepseek.com
#   LiteLLM:     http://localhost:4000   (your proxy)
#   Ollama:      http://localhost:11434/v1
# GRAFT_BASE_URL=https://openrouter.ai/api/v1
# Reasoning effort sent on every LLM call, in your provider's own words (for
# example low, high or none; the accepted words differ by provider and model).
# Unset sends nothing and the provider's default applies. Same as --reasoning.
# Calls that force a tool are sent with reasoning off when the provider refuses
# both together; `build --deep` reports how many.
# GRAFT_REASONING=low
#
# Native Anthropic (no base URL needed):
#   GRAFT_PROVIDER=anthropic
#   GRAFT_API_KEY=sk-ant-...
#   GRAFT_MODEL=claude-sonnet-5
#
# OrcaRouter AI gateway (OpenAI-compatible, no base URL needed):
#   GRAFT_PROVIDER=orcarouter
#   GRAFT_API_KEY=sk-orca-...
#   GRAFT_MODEL=openai/gpt-4o-mini

# --- Deprecated (still honored as a fallback) ---------------------------------
# If GRAFT_API_KEY is unset, these legacy OpenRouter vars are used instead.
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# GRAFT_OPENROUTER_MODEL=openai/gpt-4o-mini
#
# If GRAFT_API_KEY and the OpenRouter fallback are both unset, OrcaRouter's
# vars are honored as a second fallback.
# ORCAROUTER_API_KEY=sk-orca-...
# ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1
# ORCAROUTER_MODEL=openai/gpt-4o-mini

# --- Graph location -----------------------------------------------------------
# Where the graph lives (default: <repo>/graft)
# GRAFT_DIR=graft

# --- Build side effects (opt-out) ---------------------------------------------
# GRAFT_NO_GITIGNORE=1  — skip writing graft/ into .gitignore (e.g. you already ignore it globally)
# GRAFT_NO_IGNORE=1     — skip writing .ignore (ripgrep re-admit); only if you manage search yourself

# --- Init (Claude Code) -------------------------------------------------------
# Skip writing statusLine / subagentStatusLine during `graft init` (same as
# `--no-statusline`). Use this when you already have a custom Claude Code
# statusline — a project-level field would hide one in ~/.claude/settings.json.
# GRAFT_NO_STATUSLINE=1

# --- Benchmark (bench/) -------------------------------------------------------
# Per-role model overrides for the benchmark harness.
# BENCH_AGENT_MODEL=anthropic/claude-sonnet-5
# BENCH_JUDGE_MODEL=anthropic/claude-opus-4.8
# Per-role reasoning effort (provider's words, as GRAFT_REASONING).
# Nothing reads these yet: bench/ was removed upstream (821b12f). Kept so a
# restored harness can pass them as reasoning_effort.
# Agent: a multi-turn tool loop, so high, the default; max inflates the output
# tokens the benchmark measures.
# Judge: one call per trial grading against a reference, so max; it is the only
# way to keep the judge stronger than the agent when both run the same model.
# BENCH_AGENT_REASONING=high
# BENCH_JUDGE_REASONING=max

# --- Index tiers (on by default) ----------------------------------------------
# `graft build` indexes Markdown, configuration, markup and build files (the
# structured tier), PDF, DOCX, ODT, EPUB, PPTX and ODP documents (the documents
# tier, which needs the structured tier) and asks a language server on PATH for
# compiler-grade call edges (LSP). Set a variable to 0 to turn one off for every
# repository, or use --no-structured, --no-documents or --no-lsp, which are saved
# in .graft/config.json. Any other non-empty value turns the tier on.
# GRAFT_STRUCTURED=0
# GRAFT_DOCUMENTS=0
# GRAFT_LSP=0
